











import pandas as pd
# simple DataFrame 
data = {
    'Name': ['Alice', 'Bob', 'Charlie'],
    'Math': [85, 78, 92],
    'Science': [90, 82, 89],
    'English': [88, 85, 94]
}
df = pd.DataFrame(data)
df


df2 = df.melt(id_vars=['Name'], value_vars=['Math','Science','English'], var_name="Subject", value_name="Score")
df2














new_df = df2.pivot(index="Name", columns="Subject", values="Score")
print(new_df)






