for i in range(1,51):
    url = requests.get("https://books.toscrape.com/catalogue/page-{i}.html")
    with open (f"htmls/page{i}.html" , 'w', encoding = 'utf-8') as f:
        f.write(url.text)
    print(f"Downloaded paage {i} Successfuly")



